        "start": 4.8,
        "end": 10.26,
        "sceneEnd": 10.9,
        "spoken": 5.46,
        "tempo": 1.0,
        "text": "عَ ProHost بِخْتار الـ shift الصَّباحي، التَّلاتا والخَميس، لَأَرْبَع جِمَع… وبِبْعَت الطَّلَب."
      },
      {
        "line": 3,
        "engine": "chirp3-hd/ar-XA",
        "start": 11.15,
        "end": 14.43,
        "sceneEnd": 14.9,
        "spoken": 3.28,
        "tempo": 1.0,
        "text": "صار عِنْدي عِيادْتي، يَوْمَيْن بِالجِمْعَة. ProHost."
      }
    ],
    "trackSeconds": 15.0
  },
  {
    "post": "post4_trainer",
