        "start": 3.15,
        "end": 6.25,
        "sceneEnd": 6.25,
        "spoken": 3.61,
        "tempo": 1.163,
        "text": "كِلّ المَكاتِب عَالخَريطَة، احْجُوز بِاليَوْم، أَو بِالسّاعَة."
      },
      {
        "line": 3,
        "engine": "chirp3-hd/ar-XA",
        "start": 6.45,
        "end": 9.55,
        "sceneEnd": 9.55,
        "spoken": 3.7,
        "tempo": 1.195,
        "text": "بْتِعْرِف شو فاضي هَلَّأ، وبْتِحْكي صاحِب المَحَلّ عَالْ WhatsApp."
      },
      {
        "line": 4,
        "engine": "chirp3-hd/ar-XA",
        "start": 9.75,
        "end": 11.97,
        "sceneEnd": 12.35,
        "spoken": 2.23,
        "tempo": 1.0,
        "text": "وْلَأَصْحاب المَساحات، كِلّ شي قِدّامَك."
      },
      {
        "line": 5,
        "engine": "chirp3-hd/ar-XA",
        "start": 12.6,
        "end": 14.95,
        "sceneEnd": 14.95,
        "spoken": 2.76,
        "tempo": 1.174,
        "text": "برو هوست: لاقيها، احْجِزْها، وِشْتِغِل."
      }
    ],
    "trackSeconds": 15.0
  },
  {
    "post": "post3_psychologist",
    "voice": "Achernar",
    "gender": "female",
    "lines": [
      {
        "line": 1,
