        "start": 0.25,
        "end": 2.48,
        "sceneEnd": 3.55,
        "spoken": 2.24,
        "tempo": 1.0,
        "text": "عِنْدَك مَكْتَب أَو عِيادِة… فاضْيِة؟"
      },
      {
        "line": 2,
        "engine": "gemini-2.5-pro-tts/ar-EG",
        "start": 3.8,
        "end": 8.05,
        "sceneEnd": 8.05,
        "spoken": 5.33,
        "tempo": 1.254,
        "text": "مَع ProHost أَجِّرْها عَ ذَوْأَك: بِالسّاعَة، بِاليَوْم، بِالشَّهْر، أَو عَ الشَّخْص."
