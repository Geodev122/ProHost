        "start": 0.25,
        "end": 1.88,
        "sceneEnd": 3.55,
        "spoken": 1.63,
        "tempo": 1.0,
        "text": "عِنْدَك مَكْتَب أَو عِيادِة… فاضْيِة؟"
      },
      {
        "line": 2,
        "engine": "chirp3-hd/ar-XA",
        "start": 3.8,
        "end": 8.09,
        "sceneEnd": 8.05,
        "spoken": 5.58,
        "tempo": 1.3,
        "text": "مَع ProHost أَجِّرْها عَ ذَوْأَك: بِالسّاعَة، بِاليَوْم، بِالشَّهْر، أَو عَ الشَّخْص."
      },
      {
        "line": 3,
        "engine": "chirp3-hd/ar-XA",
        "start": 8.4,
        "end": 11.43,
        "sceneEnd": 11.4,
        "spoken": 3.95,
        "tempo": 1.3,
        "text": "كِلّ الطَّلَبات بْمَحَلّ واحَد، وبْتْغَيِّر سِعْرَك وَئِت ما بَدَّك."
      },
      {
        "line": 4,
        "engine": "chirp3-hd/ar-XA",
        "start": 11.65,
        "end": 14.92,
        "sceneEnd": 14.9,
        "spoken": 3.51,
        "tempo": 1.081,
        "text": "وْهَلَّأ، أَوَّل شَهْر اشْتِراك بْنُصّ السِّعْر! نَزِّل برو هوست."
      }
    ],
    "trackSeconds": 15.0
  },
  {
    "post": "post2_app",
    "voice": "Aoede",
    "gender": "female",
    "lines": [
      {
        "line": 1,
