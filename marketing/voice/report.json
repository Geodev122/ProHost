        "line": 3,
        "engine": "chirp3-hd/ar-XA",
        "start": 11.15,
        "end": 14.09,
        "sceneEnd": 14.9,
        "spoken": 2.94,
        "tempo": 1.0,
        "text": "تْمَنْطَعْشَر كِرْسي… بْكَبْسِة وِحْدِة! ProHost."
      }
    ],
    "trackSeconds": 15.0
  },
  {
