        "start": 0.3,
        "end": 4.44,
        "sceneEnd": 4.55,
        "spoken": 4.15,
        "tempo": 1.0,
        "text": "أَنا psychologist بِالأَشْرَفِيِّة. بَدّي عِيادِة يَوْمَيْن بِالجِمْعَة بَسّ."
