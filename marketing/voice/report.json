[
  {
    "post": "post1_hosts",
    "voice": "Orus",
    "gender": "male",
    "lines": [
      {
        "line": 1,
        "engine": "chirp3-hd/ar-XA",
        "start": 0.25,
        "end": 2.33,
        "sceneEnd": 3.55,
        "spoken": 2.08,
        "tempo": 1.0,
        "text": "عندك مكتب أو عيادة… قاعدة فاضية؟"
      },
      {
        "line": 2,
        "engine": "chirp3-hd/ar-XA",
        "start": 3.8,
        "end": 8.17,
        "sceneEnd": 8.05,
        "spoken": 5.66,
        "tempo": 1.3,
        "text": "مع برو هوست أجّرها عَ ذوقك: بالساعة، باليوم، بالشهر، أو عَ الشخص."
      },
      {
        "line": 3,
        "engine": "chirp3-hd/ar-XA",
        "start": 8.4,
        "end": 11.4,
        "sceneEnd": 11.4,
        "spoken": 3.27,
        "tempo": 1.091,
        "text": "كل الطلبات بمحل واحد، وبتغيّر سعرك وقت ما بدّك."
      },
      {
        "line": 4,
        "engine": "chirp3-hd/ar-XA",
        "start": 11.65,
        "end": 14.56,
        "sceneEnd": 14.9,
        "spoken": 2.91,
        "tempo": 1.0,
        "text": "وهلّق، أوّل شهر بنصّ السعر! نزّل برو هوست."
      }
    ],
    "trackSeconds": 15.0
  },
  {
    "post": "post2_app",
    "voice": "Aoede",
    "gender": "female",
    "lines": [
      {
        "line": 1,
        "engine": "chirp3-hd/ar-XA",
        "start": 0.35,
        "end": 1.7,
        "sceneEnd": 2.95,
        "spoken": 1.35,
        "tempo": 1.0,
        "text": "شغلك… بشروطك."
      },
      {
        "line": 2,
        "engine": "chirp3-hd/ar-XA",
        "start": 3.15,
        "end": 6.26,
        "sceneEnd": 6.25,
        "spoken": 3.7,
        "tempo": 1.193,
        "text": "كل المساحات عالخريطة، واحجز بالساعة أو بالشهر."
      },
      {
        "line": 3,
        "engine": "chirp3-hd/ar-XA",
        "start": 6.45,
        "end": 9.56,
        "sceneEnd": 9.55,
        "spoken": 3.34,
        "tempo": 1.078,
        "text": "بتعرف شو فاضي هلّق، وبتحكي صاحب المحل عالواتساب."
      },
      {
        "line": 4,
        "engine": "chirp3-hd/ar-XA",
        "start": 9.75,
        "end": 12.13,
        "sceneEnd": 12.35,
        "spoken": 2.39,
        "tempo": 1.0,
        "text": "ولأصحاب المساحات، كل شي قدّامك."
      },
      {
        "line": 5,
        "engine": "chirp3-hd/ar-XA",
        "start": 12.6,
        "end": 14.95,
        "sceneEnd": 14.95,
        "spoken": 3.01,
        "tempo": 1.279,
        "text": "برو هوست: لاقيها، احجزها، واشتغل."
      }
    ],
    "trackSeconds": 15.0
  },
  {
    "post": "post3_psychologist",
    "voice": "Achernar",
    "gender": "female",
    "lines": [
      {
        "line": 1,
        "engine": "chirp3-hd/ar-XA",
        "start": 0.3,
        "end": 4.56,
        "sceneEnd": 4.55,
        "spoken": 4.38,
        "tempo": 1.031,
        "text": "مرحبا، أنا معالِجة نفسية بالأشرفية. بدّي عيادة يومين بالجمعة بس."
      },
      {
        "line": 2,
        "engine": "chirp3-hd/ar-XA",
        "start": 4.8,
        "end": 10.17,
        "sceneEnd": 10.9,
        "spoken": 5.38,
        "tempo": 1.0,
        "text": "عَ برو هوست بختار الشيفت الصبحي، التلاتا والخميس، لأربع جمع… وببعت الطلب."
      },
      {
        "line": 3,
        "engine": "chirp3-hd/ar-XA",
        "start": 11.15,
        "end": 14.08,
        "sceneEnd": 14.9,
        "spoken": 2.94,
        "tempo": 1.0,
        "text": "صار عندي عيادتي، يومين بالجمعة. برو هوست."
      }
    ],
    "trackSeconds": 15.0
  },
  {
    "post": "post4_trainer",
    "voice": "Fenrir",
    "gender": "male",
    "lines": [
      {
        "line": 1,
        "engine": "chirp3-hd/ar-XA",
        "start": 0.3,
        "end": 4.55,
        "sceneEnd": 4.55,
        "spoken": 4.59,
        "tempo": 1.079,
        "text": "مرحبا، أنا مدرّب شركات. عندي تمنطعش متدرّب السبت… وما بدّي قهوة!"
      },
      {
        "line": 2,
        "engine": "chirp3-hd/ar-XA",
        "start": 4.8,
        "end": 10.6,
        "sceneEnd": 10.9,
        "spoken": 5.82,
        "tempo": 1.0,
        "text": "عَ برو هوست القاعة مسعّرة عَ الشخص: بحط تمنطعش، بزيد كوفي بريك، وببعت الطلب."
      },
      {
        "line": 3,
        "engine": "chirp3-hd/ar-XA",
        "start": 11.15,
        "end": 13.69,
        "sceneEnd": 14.9,
        "spoken": 2.55,
        "tempo": 1.0,
        "text": "تمنطعش كرسي… بكبسة وحدة! برو هوست."
      }
    ],
    "trackSeconds": 15.0
  },
  {
    "post": "post5_lifecoach",
    "voice": "Leda",
    "gender": "female",
    "lines": [
      {
        "line": 1,
        "engine": "chirp3-hd/ar-XA",
        "start": 0.3,
        "end": 4.55,
        "sceneEnd": 4.55,
        "spoken": 4.72,
        "tempo": 1.111,
        "text": "مرحبا، أنا لايف كوتش بالحمرا. عندي جلستين اليوم… ليش إدفع شهر؟"
      },
      {
        "line": 2,
        "engine": "chirp3-hd/ar-XA",
        "start": 4.8,
        "end": 8.46,
        "sceneEnd": 10.9,
        "spoken": 3.66,
        "tempo": 1.0,
        "text": "بفتح برو هوست، بشوف شو فاضي، بختار الساعة أربعة وخمسة… وخلصت!"
      },
      {
        "line": 3,
        "engine": "chirp3-hd/ar-XA",
        "start": 11.15,
        "end": 14.29,
        "sceneEnd": 14.9,
        "spoken": 3.14,
        "tempo": 1.0,
        "text": "احجز بالساعة، واشتغل من وين ما بدّك. برو هوست."
      }
    ],
    "trackSeconds": 15.0
  },
  {
    "post": "post6_dietitian",
    "voice": "Sulafat",
    "gender": "female",
    "lines": [
      {
        "line": 1,
        "engine": "chirp3-hd/ar-XA",
        "start": 0.3,
        "end": 4.5,
        "sceneEnd": 4.55,
        "spoken": 4.21,
        "tempo": 1.0,
        "text": "مرحبا، أنا أخصائية تغذية بجونيه. بدّي عيادتي… بلا عقد طويل."
      },
      {
        "line": 2,
        "engine": "chirp3-hd/ar-XA",
        "start": 4.8,
        "end": 9.1,
        "sceneEnd": 10.9,
        "spoken": 4.31,
        "tempo": 1.0,
        "text": "عَ برو هوست لقيت عيادة جاهزة، اخترت تلات شهور… وببلّش الشهر الجاي."
      },
      {
        "line": 3,
        "engine": "chirp3-hd/ar-XA",
        "start": 11.15,
        "end": 14.91,
        "sceneEnd": 14.9,
        "spoken": 4.47,
        "tempo": 1.192,
        "text": "عيادتك الخاصة، شهر بشهر، بلا عقد طويل. برو هوست."
      }
    ],
    "trackSeconds": 15.0
  }
