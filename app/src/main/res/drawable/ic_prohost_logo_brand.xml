<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ProHost mark: a location pin containing the workspace silhouette (office -->
    <!-- chair + monitor) on a two-facet base wedge. Used standalone wherever the -->
    <!-- app shows "just the logo" (drawer header, in-app brand moments); the -->
    <!-- splash/login screens pair this with a separate two-tone "ProHost" Text -->
    <!-- composable rather than baking the wordmark into this vector. -->

    <!-- soft contact shadow -->
    <path
        android:fillColor="#2E000000"
        android:pathData="M42,101a12,2.4 0 1,0 24,0a12,2.4 0 1,0 -24,0" />

    <path android:pathData="M 54,76 C 52.3,73.2 34,57 34,44 C 34,32.95 42.95,24 54,24 C 65.05,24 74,32.95 74,44 C 74,57 55.7,73.2 54,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34" android:startY="24"
                android:endX="74" android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF3D7BFF" />
                <item android:offset="0.5" android:color="#FF1E56C3" />
                <item android:offset="1.0" android:color="#FF0B2E73" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Everything below is clipped to the pin outline above, so the wedge (which is -->
    <!-- wider than the pin at that height) and the glow never bleed past the mark. -->
    <group android:name="prohost_pin_content_group">
        <clip-path android:pathData="M 54,76 C 52.3,73.2 34,57 34,44 C 34,32.95 42.95,24 54,24 C 65.05,24 74,32.95 74,44 C 74,57 55.7,73.2 54,76 Z" />

        <path android:pathData="M50,32m-24,0a24,24 0 1,0 48,0a24,24 0 1,0 -48,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="50" android:centerY="32"
                    android:gradientRadius="24"
                    android:type="radial">
                    <item android:offset="0.0" android:color="#E68CC2FF" />
                    <item android:offset="0.4" android:color="#594C8CFF" />
                    <item android:offset="1.0" android:color="#004C8CFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Base wedge, tapering into the pin's own tip -->
        <path android:pathData="M 24,58 L 54,76 L 54,90 L 24,90 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="24" android:startY="58"
                    android:endX="54" android:endY="76"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF081633" />
                    <item android:offset="1.0" android:color="#FF040D22" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M 84,58 L 54,76 L 54,90 L 84,90 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54" android:startY="58"
                    android:endX="84" android:endY="76"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF82B4FF" />
                    <item android:offset="1.0" android:color="#FF1E56C3" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#A603102B"
            android:pathData="M22,54.7 L86,54.7 L86,56.3 L22,56.3 Z" />

        <!-- Office chair -->
        <path android:fillColor="#FF0A1B3E" android:pathData="M 42.45,27.6 C 42.45,26.665 43.165,25.95 44.1,25.95 L 47.95,25.95 C 48.885,25.95 49.6,26.665 49.6,27.6 L 49.6,42.45 L 42.45,42.45 Z" />
        <path android:fillColor="#FF0A1B3E" android:pathData="M 49.6,34.2 L 52.625,34.2 C 53.45,34.2 54,34.86 54,35.685 L 54,40.8 L 52.075,40.8 L 52.075,36.125 L 49.6,36.125 Z" />
        <path android:fillColor="#FF0A1B3E" android:pathData="M 38.6,42.45 L 53.45,42.45 C 54.165,42.45 54.825,43.11 54.825,43.825 C 54.825,44.54 54.165,45.2 53.45,45.2 L 38.6,45.2 C 37.885,45.2 37.225,44.54 37.225,43.825 C 37.225,43.11 37.885,42.45 38.6,42.45 Z" />
        <path android:fillColor="#FF0A1B3E" android:pathData="M 45.2,45.2 L 46.85,45.2 L 46.85,49.6 L 45.2,49.6 Z" />
        <path android:fillColor="#FF0A1B3E" android:pathData="M 46.025,49.6 L 38.6,52.625 L 38.6,53.725 L 46.025,51.25 Z" />
        <path android:fillColor="#FF0A1B3E" android:pathData="M 46.025,49.6 L 53.45,52.625 L 53.45,53.725 L 46.025,51.25 Z" />
        <path android:fillColor="#FF0A1B3E" android:pathData="M 44.925,51.25 L 47.125,51.25 L 47.125,53.45 L 44.925,53.45 Z" />

        <!-- Monitor -->
        <path android:fillColor="#FF0A1B3E" android:pathData="M 57.85,30.9 L 69.4,30.9 C 70.335,30.9 71.05,31.615 71.05,32.55 L 71.05,41.9 C 71.05,42.835 70.335,43.55 69.4,43.55 L 57.85,43.55 C 56.915,43.55 56.2,42.835 56.2,41.9 L 56.2,32.55 C 56.2,31.615 56.915,30.9 57.85,30.9 Z M 58.125,32.275 C 57.96,32.275 57.85,32.385 57.85,32.55 L 57.85,41.9 C 57.85,42.065 57.96,42.175 58.125,42.175 L 69.125,42.175 C 69.29,42.175 69.4,42.065 69.4,41.9 L 69.4,32.55 C 69.4,32.385 69.29,32.275 69.125,32.275 Z" />
        <path android:fillColor="#FF0A1B3E" android:pathData="M 62.8,43.55 L 64.45,43.55 L 64.45,46.3 L 62.8,46.3 Z" />
        <path android:fillColor="#FF0A1B3E" android:pathData="M 60.05,46.3 L 67.2,46.3 C 67.75,46.3 67.97,47.07 67.42,47.4 L 59.83,47.4 C 59.28,47.07 59.5,46.3 60.05,46.3 Z" />
    </group>

</vector>
