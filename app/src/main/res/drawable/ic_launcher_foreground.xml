        <!-- Crisp Bold White Checkmark (Signifying instant booking confirmation) -->
        <!-- Checkmark drop shadow -->
        <path
            android:fillColor="#33081E47"
            android:pathData="M 45,46.5 L 51,52.5 L 63,40.5 L 66.5,44 L 51,59.5 L 41.5,50 Z" />

        <!-- Checkmark Pure White Solid Foreground -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 45,45 L 51,51 L 63,39 L 66.5,42.5 L 51,58 L 41.5,48.5 Z" />

        <!-- Soft top-left specular gleam on the pin -->
        <path
            android:fillColor="#33FFFFFF"
            android:pathData="M 54,24 C 44.5,24 36.6,31.2 34.6,40.5 C 37,33.5 44.5,28 54,28 C 58.5,28 62.5,29.5 65.8,32.2 C 62.5,27.2 58.5,24 54,24 Z" />

