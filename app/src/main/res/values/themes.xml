<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- API 31+ only (ignored below): matches the in-app SplashScreen's ground so
             the system splash doesn't flash white before Compose takes over. The
             animated-icon slot is deliberately left unset — it renders a small centered
             icon, not a full-bleed image, so the launcher icon is the right default. -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>
