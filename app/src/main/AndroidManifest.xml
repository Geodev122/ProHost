<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Google Play Hardware Filtering Configuration (ensures compatibility across all devices) -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:name=".ProHostApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${MAPS_API_KEY}" />
        <activity
            android:name="com.example.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.MyApplication.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Whish payment redirect App Link: hopebearer-award.com/payment/success|failure
                 (see functions/src/payments/initiateWhishPayment.ts). This domain is
                 reserved for Whish's payment-gateway channel API configuration only —
                 do not add other link families to it. Verified via
                 https://hopebearer-award.com/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="hopebearer-award.com"
                    android:pathPrefix="/payment" />
            </intent-filter>

            <!-- Listing share App Link: pro-host.tech/listing/{spaceId} (see
                 functions/src/listings/shareLanding.ts and ShareLinks.kt) —
                 ProHost's own registered marketing/App-Link domain, connected as
                 a custom domain to this same Firebase Hosting site (already
                 carrying the marketing landing page + legal docs). Deliberately
                 separate from hopebearer-award.com above, which is Whish's
                 payment channel only. Verified via
                 https://pro-host.tech/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="pro-host.tech"
                    android:pathPrefix="/listing" />
            </intent-filter>

            <!-- Fallback for the same Whish redirect: a custom scheme needs no OS-level
                 Digital Asset Links verification, so it still works when the App Link
                 above silently fails to verify (stale cert fingerprint, a browser that
                 doesn't honor App Links, "always open in browser" previously chosen).
                 public/payment/success.html and failure.html link here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="prohost"
                    android:host="payment" />
            </intent-filter>
        </activity>

        <service
            android:name="com.example.service.ProHostMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Exposes generated legal-document PDFs (LegalPdfGenerator.kt) to the
             system PDF viewer / share sheet via a content:// Uri, without needing
             any storage permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
