{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix functions run build"
    ]
  },
  "extensions": {},
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/app", "destination": "/get", "type": 302 },
      { "source": "/download", "destination": "/get", "type": 302 },
      { "source": "/ig", "destination": "/get?utm_source=instagram&utm_medium=social&utm_campaign=launch", "type": 302 },
      { "source": "/fb", "destination": "/get?utm_source=facebook&utm_medium=social&utm_campaign=launch", "type": 302 },
      { "source": "/wa", "destination": "/get?utm_source=whatsapp&utm_medium=social&utm_campaign=launch", "type": 302 },
      { "source": "/li", "destination": "/get?utm_source=linkedin&utm_medium=social&utm_campaign=launch", "type": 302 },
      { "source": "/qr", "destination": "/get?utm_source=qr&utm_medium=print&utm_campaign=launch", "type": 302 }
    ],
    "rewrites": [
      { "source": "/sitemap.xml", "function": { "functionId": "siteSitemap", "region": "europe-west1" } },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/delete-account",
        "destination": "/delete-account.html"
      },
      {
        "source": "/redeem",
        "destination": "/redeem.html"
      },
      {
        "source": "/get",
        "destination": "/get.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/unsubscribe",
        "function": {
          "functionId": "mailingUnsubscribe",
          "region": "europe-west1"
        }
      },
      {
        "source": "/emaillink",
        "destination": "/emaillink.html"
      },
      {
        "source": "/listing/**",
        "function": {
          "functionId": "listingShareLanding",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      { "source": "/img/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "/media/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.@(css|woff2|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "/@(get|admin|emaillink|redeem|404)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
      { "source": "/@(get|admin|emaillink|redeem|404).html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4500
    },
    "eventarc": {
      "host": "127.0.0.1",
      "port": 9299
    },
    "tasks": {
      "host": "127.0.0.1",
      "port": 9499
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
