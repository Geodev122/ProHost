{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "dataconnect": {
    "source": "./dataconnect"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": [
      "npm --prefix functions run build"
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/privacy.html",
        "destination": "/privacy",
        "type": 301
      },
      {
        "source": "/terms.html",
        "destination": "/terms",
        "type": 301
      },
      {
        "source": "/revocation.html",
        "destination": "/revocation",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/privacy",
        "function": {
          "functionId": "legalDocumentPage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/terms",
        "function": {
          "functionId": "legalDocumentPage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/revocation",
        "function": {
          "functionId": "legalDocumentPage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/delete-account",
        "destination": "/delete-account.html"
      },
      {
        "source": "/payment/success",
        "destination": "/payment/success.html"
      },
      {
        "source": "/payment/failure",
        "destination": "/payment/failure.html"
      },
      {
        "source": "/listing/**",
        "function": {
          "functionId": "listingShareLanding",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  }
}
