rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == "ADMIN";
    }

    function withinSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Raster images only: SVG can carry script and these paths are publicly readable.
    function isPhoto() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Private documents (owner/admin-readable only): PDF or any raster image a phone
    // camera produces (HEIC included) — never SVG.
    function isDocument() {
      return request.resource.contentType == 'application/pdf' ||
        (request.resource.contentType.matches('image/.*') && request.resource.contentType != 'image/svg+xml');
    }

    // Profile pictures. Publicly readable (shown wherever a member's identity is
    // displayed to someone else, e.g. a booking request) but writable only by the
    // account owner or an Admin.
    match /profile_pictures/{uid}/{fileName} {
      allow read: if true;
      // "create, update" rather than "write" — write includes delete, which
      // would make the "allow delete: if false" below dead.
      allow create, update: if isSignedIn() && (request.auth.uid == uid || isAdmin()) &&
        withinSizeLimit() &&
        isPhoto();
      allow delete: if false;
    }

    // Optional proof a Pro Host uploads to EARN the Listing Verified badge.
    match /listing_verification_docs/{spaceId}/{fileName} {
      allow read: if isSignedIn() &&
        (isAdmin() ||
         (firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) &&
          firestore.get(/databases/(default)/documents/workspace_listings/$(spaceId)).data.ownerId == request.auth.uid));
      allow create, update: if isSignedIn() &&
        (isAdmin() ||
         (request.auth.token.get('suspended', false) != true &&
          (!firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) ||
           firestore.get(/databases/(default)/documents/workspace_listings/$(spaceId)).data.ownerId == request.auth.uid))) &&
        withinSizeLimit() &&
        isDocument();
      allow delete: if false;
    }

    // Signed leasing agreement a Pro Host uploads when finalizing acceptance of a
    // booking request.
    match /booking_agreements/{bookingId}/{fileName} {
      allow read: if isSignedIn() &&
        (isAdmin() ||
         (firestore.exists(/databases/(default)/documents/booking_requests/$(bookingId)) &&
          (firestore.get(/databases/(default)/documents/booking_requests/$(bookingId)).data.ownerId == request.auth.uid ||
           firestore.get(/databases/(default)/documents/booking_requests/$(bookingId)).data.practitionerId == request.auth.uid)));
      // Create-only: a signed lease can't be swapped after acceptance.
      allow create: if isSignedIn() &&
        (isAdmin() ||
         (firestore.exists(/databases/(default)/documents/booking_requests/$(bookingId)) &&
          firestore.get(/databases/(default)/documents/booking_requests/$(bookingId)).data.ownerId == request.auth.uid)) &&
        withinSizeLimit() &&
        isDocument();
      allow update, delete: if false;
    }

    // Listing photos (whole space, cover, subdivisions). Publicly readable.
    // Recursive match allowing subfolders under /listings/{spaceId}/.
    match /listings/{spaceId}/{allPaths=**} {
      allow read: if true;
      // Only Pro Hosts upload photos for a listing that isn't saved yet (the wizard
      // uploads before the first save); otherwise only the listing's owner.
      allow create, update: if isSignedIn() &&
        (isAdmin() ||
         (request.auth.token.get('suspended', false) != true &&
          ((!firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) && role() == "PRO_HOST") ||
           (firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) &&
            firestore.get(/databases/(default)/documents/workspace_listings/$(spaceId)).data.ownerId == request.auth.uid)))) &&
        withinSizeLimit() &&
        isPhoto();
      allow delete: if isSignedIn() &&
        (isAdmin() ||
         (!firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) && role() == "PRO_HOST") ||
         (firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) &&
          firestore.get(/databases/(default)/documents/workspace_listings/$(spaceId)).data.ownerId == request.auth.uid));
    }

    // Admin-uploaded, versioned content for the 3 in-app HTML legal documents
    // (Privacy Policy / Terms of Use / Revocation Policy) and the re-rental
    // authorization template PDF — see LegalDocumentVersion. Every version is
    // its own permanent object (legal_documents/{docId}/v{version}.{ext},
    // {version} baked into the filename) — create-only, so a re-upload can
    // never destroy or silently replace a prior published version. Public read:
    // this is exactly what a signed-out user on the registration screen, or a
    // Pro Host downloading the re-rental template, needs to load.
    match /legal_documents/{docId}/{fileName} {
      allow read: if true;
      allow create: if isAdmin() && withinSizeLimit() &&
        (request.resource.contentType == 'text/html' || request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }

    // Default deny for everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
