rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == "ADMIN";
    }

    function withinSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Registrant ID documents (national ID / passport), one per account — required
    // once at registration, kept on file with no admin review workflow (see
    // AppUser.idDocumentUrl's doc comment: there is no accreditation system
    // anymore). Only the owning user can read/write their own file; Admins can
    // read for reference, never write.
    match /id_documents/{uid}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // create/update, not the "write" shorthand — write includes delete, which
      // would make the "allow delete: if false" below a dead no-op (Storage
      // rules OR every matching allow block for a method; a true delete below
      // can't override a write rule that already permits it). Splitting these
      // is what actually makes this file permanently non-deletable, matching
      // the stated intent that a registrant's ID document is kept on file.
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        withinSizeLimit() &&
        (request.resource.contentType == 'application/pdf' ||
         request.resource.contentType.matches('image/.*'));
      allow delete: if false;
    }

    // Profile pictures. Publicly readable (shown wherever a member's identity is
    // displayed to someone else, e.g. a booking request) but writable only by the
    // account owner or an Admin.
    match /profile_pictures/{uid}/{fileName} {
      allow read: if true;
      // See id_documents above for why this is "create, update" rather than
      // "write" — write already includes delete, which would make the
      // "allow delete: if false" below dead.
      allow create, update: if isSignedIn() && (request.auth.uid == uid || isAdmin()) &&
        withinSizeLimit() &&
        request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Pro Host proof of ownership / right to rent, one per listing — required at
    // listing-creation time, kept on file with no admin review workflow (see
    // SpaceListing.ownershipProofUrl's doc comment). Same "Firestore doc may not
    // exist yet" bootstrapping as listing photos below, since this uploads before
    // "Publish Listing" is tapped. Never publicly readable (unlike listing photos)
    // — this is a legal/ownership document, not marketing material.
    match /listing_ownership_docs/{spaceId}/{fileName} {
      allow read: if isSignedIn() &&
        (isAdmin() ||
         (firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) &&
          firestore.get(/databases/(default)/documents/workspace_listings/$(spaceId)).data.ownerId == request.auth.uid));
      // The "!exists()" branch is a real, accepted gap, not an oversight: while
      // the wizard's Firestore doc doesn't exist yet (uploads happen before
      // Publish), Storage has no way to check WHICH PRO_HOST is entitled to
      // this not-yet-created spaceId, so any signed-in, non-suspended PRO_HOST
      // can write here for that brief pre-publish window. Practically bounded
      // by spaceId being a random client-generated id (see CreateListingDialog's
      // listingId) an attacker would have to both guess and race — closing it
      // completely needs a client-side "reserve the Draft doc up front" change,
      // deliberately not done here (see the follow-up task tracked for it: it
      // needs a delete-draft affordance too, or an abandoned dialog open would
      // leave an orphaned, undeletable Draft behind). The suspended check below
      // is new — previously a suspended host could still write here even though
      // they're blocked from creating the listing itself.
      allow create, update: if isSignedIn() &&
        (isAdmin() ||
         (role() == "PRO_HOST" && request.auth.token.suspended != true &&
          (!firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) ||
           firestore.get(/databases/(default)/documents/workspace_listings/$(spaceId)).data.ownerId == request.auth.uid))) &&
        withinSizeLimit() &&
        (request.resource.contentType == 'application/pdf' ||
         request.resource.contentType.matches('image/.*'));
      allow delete: if false;
    }

    // Optional proof a Pro Host uploads to EARN the Listing Verified badge — either
    // a re-rental authorization statement signed by the real property owner, or
    // proof the Pro Host is the real owner (see SpaceListing.verificationDocUrl's
    // doc comment). Not required to publish, unlike listing_ownership_docs above —
    // this only feeds requestListingVerification (Cloud Function, Admin SDK),
    // which checks verificationDocUrl is set before flipping isVerified. Same
    // bootstrapping/read/write shape as listing_ownership_docs since a host may
    // reasonably upload this before or after publishing.
    match /listing_verification_docs/{spaceId}/{fileName} {
      allow read: if isSignedIn() &&
        (isAdmin() ||
         (firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) &&
          firestore.get(/databases/(default)/documents/workspace_listings/$(spaceId)).data.ownerId == request.auth.uid));
      // See listing_ownership_docs above for why the "!exists()" bootstrap
      // branch is a real, accepted, narrow gap rather than an oversight.
      allow create, update: if isSignedIn() &&
        (isAdmin() ||
         (role() == "PRO_HOST" && request.auth.token.suspended != true &&
          (!firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) ||
           firestore.get(/databases/(default)/documents/workspace_listings/$(spaceId)).data.ownerId == request.auth.uid))) &&
        withinSizeLimit() &&
        (request.resource.contentType == 'application/pdf' ||
         request.resource.contentType.matches('image/.*'));
      allow delete: if false;
    }

    // Signed leasing agreement a Pro Host uploads when finalizing acceptance of a
    // booking request (see BookingRequest.agreementUrl's doc comment) — the record
    // that host and specialist reached a real agreement; payment itself happens
    // outside the app entirely, and nobody at ProHost reviews this document. The
    // booking_requests doc always exists by the time a host can accept it (created
    // when the practitioner submitted the request), so no bootstrapping case is
    // needed here unlike listing photos/ownership docs. Readable by either party
    // to the booking (the specialist's Digital Key Pass links here) or an Admin;
    // writable only by the host who owns the space being booked.
    match /booking_agreements/{bookingId}/{fileName} {
      allow read: if isSignedIn() &&
        (isAdmin() ||
         (firestore.exists(/databases/(default)/documents/booking_requests/$(bookingId)) &&
          (firestore.get(/databases/(default)/documents/booking_requests/$(bookingId)).data.ownerId == request.auth.uid ||
           firestore.get(/databases/(default)/documents/booking_requests/$(bookingId)).data.practitionerId == request.auth.uid)));
      // See id_documents above for why this is "create, update" rather than
      // "write" — write already includes delete, which would make the
      // "allow delete: if false" below dead.
      allow create, update: if isSignedIn() &&
        (isAdmin() ||
         (firestore.exists(/databases/(default)/documents/booking_requests/$(bookingId)) &&
          firestore.get(/databases/(default)/documents/booking_requests/$(bookingId)).data.ownerId == request.auth.uid)) &&
        withinSizeLimit() &&
        (request.resource.contentType == 'application/pdf' ||
         request.resource.contentType.matches('image/.*'));
      allow delete: if false;
    }

    // Listing cover photos. Publicly readable (the discovery feed and listing
    // details are browsable), writable by the listing's actual owner once the
    // Firestore doc exists — or by any PRO_HOST while it doesn't yet, since
    // photos are picked and uploaded before "Publish Listing" is tapped and the
    // Firestore document is created. See listing_ownership_docs above for why
    // the "!exists()" branch is a real, accepted, narrow gap (not an
    // oversight) and why the suspended check below was added to it.
    match /listings/{spaceId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() &&
        (isAdmin() ||
         (role() == "PRO_HOST" && request.auth.token.suspended != true &&
          (!firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) ||
           firestore.get(/databases/(default)/documents/workspace_listings/$(spaceId)).data.ownerId == request.auth.uid))) &&
        withinSizeLimit() &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() &&
        (isAdmin() ||
         (firestore.exists(/databases/(default)/documents/workspace_listings/$(spaceId)) &&
          firestore.get(/databases/(default)/documents/workspace_listings/$(spaceId)).data.ownerId == request.auth.uid));
    }

    // Admin-uploaded, versioned HTML for the 3 in-app legal documents (Privacy
    // Policy / Terms of Use / Revocation Policy — see LegalDocumentVersion).
    // Every version is its own permanent object (legal_documents/{docId}/
    // v{version}.html, {version} baked into the filename) — create-only, same
    // "kept on file forever" reasoning as id_documents above, so a re-upload
    // can never destroy or silently replace a prior published version. Public
    // read: this is exactly what a signed-out user on the registration screen,
    // or anyone browsing the public policy pages, needs to load.
    match /legal_documents/{docId}/{fileName} {
      allow read: if true;
      allow create: if isAdmin() && withinSizeLimit() && request.resource.contentType == 'text/html';
      allow update, delete: if false;
    }

    // Default deny for everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
