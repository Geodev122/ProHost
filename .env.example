# ==============================================================================
# ProHost Environment & API Configuration (EXAMPLE — placeholders only)
# Package: app.geonajjar.prohost
#
# Copy this file to .env and fill in real values locally. .env is gitignored
# and must never be committed — see the Secrets rotation checklist handed to
# you separately for what to do if a real value ever leaked into git history.
# ==============================================================================

# --- Android Application Metadata ---
APPLICATION_ID=app.geonajjar.prohost
VERSION_NAME=1.0.0
VERSION_CODE=1

# --- Firebase Project Configuration ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PROJECT_NUMBER=000000000000
FIREBASE_MOBILE_APP_ID=1:000000000000:android:0000000000000000000000
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_OAUTH_CLIENT_ID=YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com

# --- Google Play Integrity API ---
PLAY_INTEGRITY_PROJECT_NUMBER=000000000000
PLAY_INTEGRITY_ENABLED=true

# --- Keystore & App Signing Fingerprints ---
# Debug Keystore SHA-1 Fingerprint
DEBUG_SHA1=YOUR_DEBUG_SHA1_FINGERPRINT
# Debug Keystore SHA-256 Fingerprint
DEBUG_SHA256=YOUR_DEBUG_SHA256_FINGERPRINT
# Release Signing Config
RELEASE_KEYSTORE_PATH=my-upload-key.jks
RELEASE_KEY_ALIAS=upload

# --- Firebase Cloud Functions Endpoints (europe-west1) ---
FUNCTIONS_REGION=europe-west1
BOOTSTRAP_SUPER_ADMIN_URL=https://bootstrapsuperadmin-YOUR_HASH-ew.a.run.app

# --- OpenStreetMap / Map Tile Server ---
OSM_TILE_SERVER=https://tile.openstreetmap.org/
OSM_USER_AGENT=app.geonajjar.prohost/1.0.0

# Google Maps API Key for Android (used in local.properties and AndroidManifest.xml)
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
