rules_version = '2';

// Real collections only (workspace_listings, user_profiles, etc. — see
// FirestoreSchema.kt). The previous version of this file protected
// prospace_bookings/users, which the app never actually used; under
// Firestore's default-deny, that meant every real collection had zero rules
// at all. No rules had ever been deployed for this project before this file
// (confirmed directly against the Firebase Rules API), so this is a from-zero
// rewrite, not a patch to a working ruleset.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == "ADMIN";
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Re-reads the caller's own live profile document rather than trusting the
    // custom claim baked into their current ID token — a suspension needs to
    // take effect immediately (the next write attempt), not only once the
    // client happens to refresh its token. Set/cleared exclusively by
    // setAccountSuspended.ts (Admin SDK); see user_profiles' protected-fields
    // list below.
    function isSuspended() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.get('isSuspended', false) == true;
    }

    // Same reasoning as isSuspended() above, for the same reason: a role
    // *downgrade* (revokeProHostRole.ts) needs to take effect on the caller's
    // very next write attempt too, not only once their ID token happens to
    // refresh (which can be up to ~1 hour later) — otherwise a just-revoked
    // Pro Host could still create new listings on a stale token for the rest
    // of that window. Trusting role() (the token claim) for an *upgrade*
    // check would be the dangerous direction; for this downgrade check, the
    // live document is authoritative the same way isSuspended() already is.
    function liveRole(uid) {
      return get(/databases/$(database)/documents/user_profiles/$(uid)).data.get('role', 'SPECIALIST');
    }

    // Package-tier listing-limit enforcement (previously client-side only —
    // ProSpaceViewModel.createNewSpaceListing checked this, but nothing
    // stopped a direct Firestore write from skipping it). `activeListingCount`
    // is a denormalized counter maintained by listingCountTracker.ts's
    // Firestore triggers, since rules can't COUNT a query directly.
    // `package2Limit` is Admin-configurable (updatePricing) rather than a
    // hardcoded "3", so a tier change takes effect without a rules redeploy.
    function withinListingLimit(uid) {
      let profile = get(/databases/$(database)/documents/user_profiles/$(uid)).data;
      let tier = profile.get('ownerPackageTier', 'PAY_AS_YOU_GO');
      let count = profile.get('activeListingCount', 0);
      let limit = get(/databases/$(database)/documents/system_metadata/pricing).data.get('package2Limit', 3);
      return tier != 'LIMITED_3_TIER' || count < limit;
    }

    // Same reasoning as withinListingLimit() above, for PAY_AS_YOU_GO's per-category
    // slots instead of LIMITED_3_TIER's whole-listing cap: without this, a raw
    // Firestore SDK write could publish a PAYG category with zero purchased credit,
    // bypassing both CreateListingDialog's disabled Publish button and
    // ProHostViewModel.createNewSpaceListing's check. paygCategoryCredits is
    // maintained only by listingCountTracker.ts's consumePaygCreditIfNeeded (this
    // function only reads it, never writes it — see user_profiles' protected-fields
    // list below for the write-side of that guarantee).
    function hasPaygCredit(uid, categoryId) {
      let profile = get(/databases/$(database)/documents/user_profiles/$(uid)).data;
      let tier = profile.get('ownerPackageTier', 'PAY_AS_YOU_GO');
      let credits = profile.get('paygCategoryCredits', {});
      return tier != 'PAY_AS_YOU_GO' || (categoryId != null && credits.get(categoryId, 0) > 0);
    }

    // ---------------------------------------------------------------
    // workspace_listings — public discovery, owner-managed
    // ---------------------------------------------------------------
    match /workspace_listings/{spaceId} {
      // A suspended host's listings stay on file (the owner and Admin can
      // still see them — a suspended host should see their own listings are
      // hidden, not have them vanish) but drop out of public Discovery, since
      // otherwise a suspended account could keep generating traffic and
      // inbound booking requests indefinitely. isOwnerSuspended is mirrored
      // onto each listing by setAccountSuspended.ts (Admin SDK) — see its
      // doc comment. Same idea for status: a Draft being built or a listing
      // the host has Paused is only visible to its own owner and Admin, not
      // the public Discovery feed — missing status reads as ACTIVE (its own
      // default) so listings written before this field existed stay visible.
      allow read: if (
        resource.data.get('isOwnerSuspended', false) == false &&
        resource.data.get('status', 'ACTIVE') == 'ACTIVE'
      ) ||
        isAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isSignedIn() &&
        (liveRole(request.auth.uid) == "PRO_HOST" || isAdmin()) &&
        request.resource.data.ownerId == request.auth.uid &&
        !isSuspended() &&
        // A Draft doesn't consume the host's quota (see ListingStatus's doc
        // comment) — only a create that lands directly as ACTIVE is gated by
        // withinListingLimit()/hasPaygCredit(); saving a brand-new Draft is exempt
        // the same way listingCountTracker.ts's create trigger only counts ACTIVE.
        (isAdmin() ||
          request.resource.data.get('status', 'ACTIVE') != 'ACTIVE' ||
          (withinListingLimit(request.auth.uid) &&
            hasPaygCredit(request.auth.uid, request.resource.data.get('spaceCategoryId', null)))) &&
        // The update rule below has always blocked isVerified/ownerIsIdVerified
        // on an existing document, but create() is a separate rule block with no
        // "before" document to diff against — without this, a brand-new listing
        // could claim isVerified:true (the "genuinely earned" badge) or
        // ownerIsIdVerified:true for free on its very first write. isVerified
        // must start false (matches SpaceListing's own Kotlin default — never
        // legitimately true at creation); ownerIsIdVerified must match the
        // owner's REAL id-document status on their own profile, not whatever the
        // client claims, so a host who hasn't actually uploaded an ID can't just
        // assert the badge.
        (isAdmin() ||
          (request.resource.data.get('isVerified', false) == false &&
            request.resource.data.get('ownerIsIdVerified', false) ==
              (get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.get('idDocumentUrl', null) != null)));

      // isVerified / isActiveSubscription / subscriptionExpiryMillis are
      // money- and verification-status fields — only setListingVerification /
      // requestListingVerification / setListingSubscriptionActive / the Whish
      // entitlement grant (all via the Admin SDK, which bypasses rules) can
      // change them. ownerId can never be reassigned by a client write.
      // isOwnerSuspended is likewise Admin-SDK-only (setAccountSuspended.ts) —
      // an owner could otherwise just un-hide their own suspended listings by
      // writing it back to false.
      allow update: if isSignedIn() && (
        (
          (isAdmin() || (role() == "PRO_HOST" && resource.data.ownerId == request.auth.uid)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ["isVerified", "isActiveSubscription", "subscriptionExpiryMillis", "ownerId", "isOwnerSuspended", "ownerIsIdVerified"]
          ) &&
          // Publishing a Draft or resuming a Paused listing (status -> ACTIVE)
          // is the moment it starts consuming the host's quota — gate that
          // transition the same way create() gates a straight-to-ACTIVE
          // create. Any other status change (staying Draft/Paused, or
          // Active -> Paused) never needs the quota check. The one case that
          // ALSO needs re-checking despite status staying ACTIVE the whole
          // time: rewriting spaceCategoryId on an already-live listing — left
          // unguarded before, a PAYG host could publish cheaply under one
          // category, then swap spaceCategoryId to any other category
          // (including one they never bought a slot for) with zero
          // enforcement. listingCountTracker.ts's onWorkspaceListingStatusChanged
          // consumes the credit for this same case server-side.
          (isAdmin() ||
            (resource.data.get('status', 'ACTIVE') == 'ACTIVE' &&
              resource.data.get('spaceCategoryId', null) == request.resource.data.get('spaceCategoryId', null)) ||
            request.resource.data.get('status', 'ACTIVE') != 'ACTIVE' ||
            (withinListingLimit(request.auth.uid) &&
              hasPaygCredit(request.auth.uid, request.resource.data.get('spaceCategoryId', null))))
        ) ||
        // Engagement counters are incremented by the Specialist viewing/
        // contacting the listing, not the owner — the owner-only clause above
        // denies every one of those writes on its own, which is exactly why
        // avatarEngagementViews/avatarInquiryClicks read stuck at zero in
        // production (see the architecture audit, finding 4.6). Scoped
        // narrowly to just these two counters (plus updatedAt) so it can't be
        // used to touch anything else.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ["avatarEngagementViews", "avatarInquiryClicks", "updatedAt"]
        )
      );

      allow delete: if isSignedIn() &&
        (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // ---------------------------------------------------------------
    // user_profiles
    // ---------------------------------------------------------------
    match /user_profiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Initial role/isVerified values on create come from the client today
      // (see AuthFlow.kt) — the actual authority for "role" is the custom
      // claim (assignInitialRole/grantAdminRole Cloud Functions), which every
      // other collection's rules check via request.auth.token.role, not this
      // field. This field is a display/query mirror of that claim. Entitlement
      // fields can't start inflated either — a brand-new profile must begin
      // at the free tier with a zero listing counter, same reasoning as the
      // update rule below.
      allow create: if isOwner(userId) &&
        request.resource.data.get('ownerPackageTier', 'PAY_AS_YOU_GO') == 'PAY_AS_YOU_GO' &&
        request.resource.data.get('activeListingCount', 0) == 0 &&
        // isVerified must match reality — the ID token's own phone_number claim
        // (the same source of truth assignInitialRole.ts already uses
        // server-side for the update path), never a bare client assertion.
        // The legitimate registration flow (ProHostRepository.registerMember)
        // does set this true at create time, but only because a real SMS-OTP
        // verification genuinely just completed — this check makes that the
        // ONLY way it can be true, not merely the app's current behavior.
        request.resource.data.get('isVerified', false) == (request.auth.token.phone_number != null) &&
        // Every one of these is either absent from AppUser.toFirestoreMap()
        // entirely (paygCategoryCredits/paygListingsBoughtCount/isSuspended/
        // createdAtMillis/lastSignInAtMillis) or null-by-default
        // (ownerPackageExpiryMillis) on a legitimate first write — without this,
        // a raw SDK create() could grant itself free PAYG credits, backdate the
        // account, or start pre-suspended/pre-expired, none of which the update
        // rule below would ever let a client set afterward.
        request.resource.data.get('paygCategoryCredits', {}) == {} &&
        request.resource.data.get('paygListingsBoughtCount', 0) == 0 &&
        request.resource.data.get('ownerPackageExpiryMillis', null) == null &&
        request.resource.data.get('isSuspended', false) == false &&
        request.resource.data.get('createdAtMillis', null) == null &&
        request.resource.data.get('lastSignInAtMillis', null) == null;

      // Once the profile exists, role/isVerified/createdAtMillis/lastSignInAtMillis/
      // isSuspended can never change via a direct client write, self or Admin —
      // only grantAdminRole (role), assignInitialRole (isVerified, synced from
      // the ID token's own phone_number claim; createdAtMillis/lastSignInAtMillis,
      // the account-creation/last-sign-in audit trail — see its doc comment), and
      // setAccountSuspended (isSuspended) can, all Admin SDK. There is no
      // admin-reviewed accreditation system anymore, so no separate
      // verificationStatus/verificationTier/trustScore fields to protect.
      // ownerPackageTier/ownerPackageExpiryMillis are entitlement fields set
      // exclusively by grantEntitlement() (the Whish webhook) or
      // revokeProHostRole (Admin SDK) — a client write could otherwise
      // self-grant an unlimited listing package for free. activeListingCount
      // is maintained only by listingCountTracker.ts's triggers, for the same
      // reason (see withinListingLimit() above — a client-writable counter
      // would make that check trivially bypassable).
      allow update: if (isOwner(userId) || isAdmin()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ["role", "isVerified", "createdAtMillis", "lastSignInAtMillis", "isSuspended",
           "ownerPackageTier", "ownerPackageExpiryMillis", "activeListingCount",
           "paygCategoryCredits", "paygListingsBoughtCount"]
        );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // subscription_formulas — reference/catalog data, not per-user pricing
    // ---------------------------------------------------------------
    match /subscription_formulas/{formulaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // hashtag_usage — one doc per hashtag, incremented on every listing publish
    // that carries it (CreateListingDialog's Target Disciplines field, spec 1.4).
    // Low-stakes aggregate counter, not per-user data — any signed-in user can
    // read it for autosuggest and write to it on publish, scoped to only the
    // fields this feature actually needs so it can't be used to smuggle arbitrary
    // data into the collection.
    // ---------------------------------------------------------------
    match /hashtag_usage/{tagId} {
      allow read: if isSignedIn();
      // Key-set-only used to be the entire check — it stopped a write from
      // smuggling in unrelated fields, but not from setting count to any
      // arbitrary number instead of the real client's FieldValue.increment(1).
      // Split into create/update so the "first time this tag is ever used"
      // and "every use after" cases can each require count be EXACTLY one
      // more than what's already there (or exactly 1 for a brand-new tag),
      // matching FirestoreService.recordHashtagUsage's own write shape and
      // rejecting anything else.
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(["tag", "count", "lastUsedAtMillis", "governorate"]) &&
        request.resource.data.tag == tagId &&
        request.resource.data.count == 1;
      allow update: if isSignedIn() &&
        request.resource.data.keys().hasOnly(["tag", "count", "lastUsedAtMillis", "governorate"]) &&
        request.resource.data.tag == tagId &&
        request.resource.data.count == resource.data.get('count', 0) + 1;
    }

    // ---------------------------------------------------------------
    // booking_requests
    // ---------------------------------------------------------------
    match /booking_requests/{bookingId} {
      allow read: if isSignedIn() &&
        (isAdmin() ||
         resource.data.practitionerId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.practitionerId == request.auth.uid &&
        !isSuspended() &&
        // ownerId must be the REAL owner of spaceId — otherwise a Specialist
        // could create a BookingRequest naming an arbitrary ownerId with a
        // fabricated totalAmountUsd, and since the read rule above allows
        // resource.data.ownerId == request.auth.uid, it would surface in that
        // host's own OwnerIncomingRequestsView/OwnerRentingProgressScreen queue
        // as if it were a genuine request for their own listing.
        request.resource.data.ownerId ==
          get(/databases/$(database)/documents/workspace_listings/$(request.resource.data.spaceId)).data.ownerId;

      // The owner (or Admin) can write anything — accept/reject, agreementUrl (the
      // signed lease uploaded when finalizing acceptance), etc. The practitioner is
      // whitelisted to exactly two things they're actually allowed to do themselves:
      // acknowledge their own outside-the-app payment, or cancel their own request —
      // never accept or reject it. Before this, any signed-in practitioner could
      // write status: ACCEPTED directly on their own PENDING request via a raw
      // Firestore SDK call, skipping the host's review entirely AND skipping the
      // accept-time double-booking check both the client
      // (ProHostRepository.acceptBookingRequest) and the server
      // (onBookingAcceptConflictGuard, functions/src/bookings/bookingConflictGuard.ts)
      // only ever run on a transition into ACCEPTED — a self-accept would never pass
      // through either. There is no in-app payment settlement to protect otherwise
      // (both sides handle payment outside the app entirely — the old
      // isExternalPaymentSettled field, and the Pay Whish flow that set it, are gone).
      allow update: if isSignedIn() &&
        (isAdmin() ||
         resource.data.practitionerId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid) &&
        (
          isAdmin() ||
          request.auth.uid == resource.data.ownerId ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentAcknowledgedBySpecialist"]) ||
          (request.resource.data.status == "CANCELLED" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ["status", "reviewedAt", "cancellationReasonCode", "cancellationNote", "cancelledByRole"]
            ))
        );

      allow delete: if isAdmin();
    }

    // user_credentials (the old admin-reviewed accreditation document
    // collection) is gone — there is no admin review workflow anymore. An
    // ID document is a single URL field on user_profiles (idDocumentUrl,
    // client-writable, no review); a Pro Host's proof of ownership is a
    // single URL field on workspace_listings (ownershipProofUrl), also
    // client-writable at listing-creation time — no dedicated collection or
    // rule needed for either.

    // ---------------------------------------------------------------
    // whish_transactions — server-only, ground truth for real payments
    // ---------------------------------------------------------------
    match /whish_transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // audit_security_logs — server-only (see recordClientAuditLog /
    // admin/* Cloud Functions, which are the only writers now)
    // ---------------------------------------------------------------
    match /audit_security_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // system_metadata — server-only (updatePricing Cloud Function is the
    // only writer; FirestoreService.initializeSchema, which would have
    // written schema_info directly, has no call sites anywhere in the app).
    // ---------------------------------------------------------------
    match /system_metadata/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // schema_architecture — space type/amenity/equipment/specialty taxonomy.
    // Unlike system_metadata (money/pricing), this touches no financial or
    // verification field, so — per the established Phase 7 design split —
    // it's a direct admin-gated write rather than a Cloud Function. Public
    // read is required: every client (not just admins) needs this taxonomy
    // to render listing creation/discovery filters.
    // ---------------------------------------------------------------
    match /schema_architecture/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
