rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared validation rules for the ProSpace booking and listing ecosystem
    match /prospace_bookings/{bookingId} {
      // Require authentication for reading or submitting booking requests
      allow read: if request.auth != null;
      
      // Allow professionals to create bookings, and space owners or admins to update status
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }
    
    match /users/{userId} {
      // Allow users to view profiles, but only the owner can modify their profile data
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
