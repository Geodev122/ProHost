# Netlify headers for the temporary host (same rules as firebase.json "headers").
/.well-known/assetlinks.json
  Content-Type: application/json
/img/*
  Cache-Control: public, max-age=604800
/media/*
  Cache-Control: public, max-age=604800
/*.css
  Cache-Control: public, max-age=86400
/get
  X-Robots-Tag: noindex
/get.html
  X-Robots-Tag: noindex
/admin
  X-Robots-Tag: noindex
/admin.html
  X-Robots-Tag: noindex
/emaillink
  X-Robots-Tag: noindex
/emaillink.html
  X-Robots-Tag: noindex
/redeem
  X-Robots-Tag: noindex
/redeem.html
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex
